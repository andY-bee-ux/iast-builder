# /etc/iast-builder/<profil>.env — réglages propres à une instance (un fichier par profil).
# Les secrets communs (clé Anthropic, secret interne, mot de passe) restent dans brain/.env et gateway/.env.
PORT=3000
BRAIN_PORT=8000
YOBAKOKO_DATA_DIR=/opt/iast-builder/brain/data
YOBAKOKO_UPLOAD_DIR=/opt/iast-builder/brain/uploads
# Pour une seconde instance, par exemple afripharm :
# PORT=3001
# BRAIN_PORT=8001
# YOBAKOKO_DATA_DIR=/opt/iast-builder/brain/data_afripharm
# YOBAKOKO_UPLOAD_DIR=/opt/iast-builder/brain/uploads_afripharm
