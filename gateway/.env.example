# Copiez vers .env.

# Mot de passe du panneau d'administration (/admin.html).
ADMIN_PASSWORD=

# Doit être identique à INTERNAL_SECRET dans brain/.env — c'est le secret que
# la gateway présente au service brain pour prouver que l'appel vient bien d'elle.
INTERNAL_SECRET=change-me-to-a-random-string

# Adresse du service brain Python (par défaut : http://localhost:8000).
BRAIN_URL=http://localhost:8000

# Port d'écoute local de la gateway.
PORT=3000
