  "regles_attribution": [
    {
      "id": "R1_double_attribution_filles",
      "enonce_fr": "SI Personne(p) ET sexeRecipiendaire(p, féminin) ALORS estAttribueA(NdabNgonLa_de_p, p) ET estAttribueA(NdabDeMekat_de_p, p).",
      "commentaire": "Une fille reçoit deux Ndab à la naissance : un du patrilignage paternel (Ndab ngon là') et un du patrilignage maternel (Ndab de Mekat)."
    },
    {
      "id": "R2_attribution_unique_garcons",
      "enonce_fr": "SI Personne(p) ET sexeRecipiendaire(p, masculin) ALORS estAttribueA(NdabDeMekat_de_p, p) ET NON estAttribueA(NdabNgonLa, p).",
      "commentaire": "Un garçon ne reçoit à la naissance que le Ndab de Mekat (issu du lignage maternel)."
    },
    {
      "id": "R3_origine_lignagere",
      "enonce_fr": "SI estDeType(n, NdabDeMekat) ALORS provientDuLignage(n, lignage_maternel) ; SI estDeType(n, NdabNgonLa) ALORS provientDuLignage(n, lignage_paternel).",
      "commentaire": "Contrainte de cohérence entre type de Ndab et ligne de filiation ; sert de test de décidabilité (une attribution incohérente avec cette règle est rejetée)."
    },
    {
      "id": "R4_habilitation_donateur",
      "enonce_fr": "SI DonateurDeNdab(d) ET estChefDe(d, l) ET GroupeLignager(l) ET provientDuLignage(n, l) ALORS estDonneParDonateur(n, d).",
      "commentaire": "Seul le chef du lignage concerné (paternel ou maternel selon le type de Ndab) est habilité à attribuer/choisir le Ndab."
    },
    {
      "id": "R5_desambiguisation_parente",
      "enonce_fr": "Les Ndab sont utilisés comme termes d'adresse en alternative aux 4 termes de parenté simple ambigus : tà (père), mà (mère), nfèt (frère/sœur), mèn (enfant).",
      "commentaire": "Fonction sociale principale attestée par Voorhoeve (1964) ; utile pour désambiguïser des requêtes de l'agent conversationnel portant sur la parenté."
    }
  ],
  "balises_qualite_donnees": [
    {
      "id": "contextualisation",
      "def_fr": "Le Ndab collecté est-il suffisamment incorporé au contexte culturel et social des chefferies du sud-est bamiléké ?"
    },
    {
      "id": "fiabilite",
      "def_fr": "Les données recueillies sur un même segment de Ndab sont-elles cohérentes et reproductibles (cf. aPourSource) ?"
    },
    {
      "id": "reflexivite",
      "def_fr": "Les biais et l'influence du chercheur sur la collecte ont-ils été identifiés ?"
    },
    {
      "id": "profondeur",
      "def_fr": "La donnée offre-t-elle une compréhension riche et détaillée du Ndab concerné ?"
    },
    {
      "id": "ethique",
      "def_fr": "La donnée a-t-elle été recueillie de manière éthique et respectueuse (consentement, CIEREH) ?"
    }
  ],
