{
  "meta": {
    "titre": "Ontologie formelle du savoir traditionnel des Ndab",
    "domaine": "Culture immatérielle bamiléké (Ndé, Cameroun) - système d'attribution de noms d'éloges",
    "sources": [
      "Nkambou, R. — Description de projet (NKARO9901), UQAM",
      "Lendja Ngnemzue, A.B. — Guide d'entretien de l'enquête de terrain (CIEREH 2026-8058)",
      "Méthodologie du volet anthropologique (AIST)",
      "Voorhoeve (1964); Barbier (1986); Julien & Rosselin (2005)",
      "NDAAP-Chefferie supérieure Bangangté, janvier 2026 (répertoire de terrain brut, 24 entrées, 343 noms attestés)"
    ],
    "avertissement": "Ontologie de première version, construite à partir des seuls documents fournis. Elle doit être validée et enrichie avec les experts CEPOM/CODEBA et l'ethnographe (Dr Lendja Ngnemzue) avant tout usage de production, en particulier pour tout ce qui touche la géographie exhaustive des chefferies et la casuistique des donateurs. Depuis l'ajout du répertoire de terrain de Bangangté (janvier 2026), l'ontologie contient également des données réelles brutes (voir clé repertoire_bangangte) dont la classification par type de Ndab reste une hypothèse à valider — voir repertoire_bangangte.meta.avertissement_critique.",
    "expressivite_cible": "Ontologie légère (lightweight), proche d'un profil OWL 2 EL : hiérarchie de classes, propriétés d'objet/de données, axiomes de disjonction et de cardinalité, complétée par des règles de type SWRL pour rendre l'attribution décidable."
  },
  "classes": [
    {
      "id": "SavoirTraditionnel",
      "parent": null,
      "def_fr": "Connaissance, pratique ou expression reconnue par une communauté comme faisant partie de son patrimoine culturel immatériel (déf. UNESCO 2003, art. 2)."
    },
    {
      "id": "Ndab",
      "parent": "SavoirTraditionnel",
      "def_fr": "Nom d'éloge / nom de remerciement attribué à la naissance, combinant parenté et topologie ; unité centrale du domaine. Synonyme rencontré dans les sources : Ndap."
    },
    {
      "id": "TypeDeNdab",
      "parent": null,
      "def_fr": "Catégorie formelle de Ndab, définie par la ligne de filiation d'où il provient et par le sexe du récipiendaire."
    },
    {
      "id": "NdabDeMekat",
      "parent": "TypeDeNdab",
      "def_fr": "Ndab « de petit-fils/petite-fille », issu du patrilignage MATERNEL. Attribué à tous les nouveau-nés, garçons et filles."
    },
    {
      "id": "NdabNgonLa",
      "parent": "TypeDeNdab",
      "def_fr": "Ndab « de fille de concession » (Ndab ngon là'), issu du patrilignage PATERNEL. Attribué exclusivement aux filles."
    },
    {
      "id": "Personne",
      "parent": null,
      "def_fr": "Individu impliqué dans le domaine, comme porteur, donateur, expert ou chercheur."
    },
    {
      "id": "PorteurDeNdab",
      "parent": "Personne",
      "def_fr": "Toute personne native d'une chefferie du Ndé (ou apparentée) à qui un ou plusieurs Ndab ont été attribués à la naissance."
    },
    {
      "id": "DonateurDeNdab",
      "parent": "Personne",
      "def_fr": "Chef de lignage (paternel ou maternel) habilité à transmettre / choisir le Ndab d'un nouveau-né de son lignage."
    },
    {
      "id": "ExpertNdab",
      "parent": "Personne",
      "def_fr": "Personne-ressource reconnue (par son lignage, par la recherche antérieure, ou par la réputation populaire) comme détentrice du répertoire et de l'histoire des Ndab. Population cible du guide d'entretien."
    },
    {
      "id": "Ethnographe",
      "parent": "Personne",
      "def_fr": "Chercheur chargé de la collecte de terrain (entretiens semi-directifs, archives)."
    },
    {
      "id": "GroupeSocial",
      "parent": null,
      "def_fr": "Regroupement social porteur ou gestionnaire du savoir traditionnel."
    },
    {
      "id": "GroupeLignager",
      "parent": "GroupeSocial",
      "def_fr": "Lignage (descent group) ; unité de filiation, paternelle ou maternelle, à laquelle un Ndab est rattaché."
    },
    {
      "id": "Chefferie",
      "parent": "GroupeSocial",
      "def_fr": "Chefferie traditionnelle bamiléké (ex. Bangangté, Bangoulap, Bakong, Bahouoc, Bahouoc-Mfen Ngava/Bali) placée sous l'autorité d'une Majesté."
    },
    {
      "id": "AireCulturelle",
      "parent": "GroupeSocial",
      "def_fr": "Regroupement de chefferies partageant un trait culturel (usage des Ndab), medumbaphones ou non."
    },
    {
      "id": "TermeDeParente",
      "parent": null,
      "def_fr": "Terme d'adresse de parenté simple, dont l'ambiguïté est précisément ce que le système des Ndab permet d'éviter."
    },
    {
      "id": "Langue",
      "parent": null,
      "def_fr": "Langue locale du département du Ndé et de ses environs."
    },
    {
      "id": "Lieu",
      "parent": null,
      "def_fr": "Localisation géographique (village, chefferie, département, région)."
    },
    {
      "id": "Metier",
      "parent": null,
      "def_fr": "Métier traditionnel de la culture matérielle (forge, poterie, sculpture sur bois...) auquel certains Ndab peuvent être rattachés."
    },
    {
      "id": "SourceDeConnaissance",
      "parent": null,
      "def_fr": "Provenance d'une donnée du répertoire : entretien semi-directif, archive, observation, contribution crowdsourcée."
    },
    {
      "id": "EntreeRepertoire",
      "parent": "SourceDeConnaissance",
      "def_fr": "Bloc généalogique tel que collecté sur le terrain pour une chefferie donnée : un donateur paternel de référence, un site d'origine, et un ou deux lignages avec leurs listes de noms de Ndab associées. Unité d'ingestion du répertoire brut, en amont de toute classification par TypeDeNdab."
    },
    {
      "id": "LignageAssocieHypothese",
      "parent": "GroupeLignager",
      "def_fr": "Lignage nommé dans une EntreeRepertoire, dont le rattachement à NdabDeMekat (ligne maternelle) ou NdabNgonLa (ligne paternelle) est une hypothèse structurelle non confirmée par l'ethnographe."
    }
  ],
