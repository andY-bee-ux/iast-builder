# Copiez vers .env.

# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6

# Modèle d'embeddings local (multilingue FR/EN), téléchargé une fois puis mis en cache.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Doit être identique à INTERNAL_SECRET dans gateway/.env — c'est ce qui empêche
# un appel direct au service brain en contournant l'authentification de la gateway.
INTERNAL_SECRET=change-me-to-a-random-string

# Port d'écoute local du service brain.
PORT=8000

# --- Phases 1 à 3 (valeurs par défaut adaptées ; à modifier seulement si besoin) ---
# Seuils de regroupement des questions d'investigation (embeddings / repli lexical).
SIGNAL_SIMILARITY=0.85
SIGNAL_JACCARD=0.6
# Lissage : true retire les phrases factuelles sans renvoi au dossier (sinon, simple consignation au journal).
RESTITUTION_STRICT=false
# Nombre maximal de connaissances validées injectées dans le dossier d'une réponse.
MAX_ENRICHMENTS_IN_PROMPT=40
# Extraction guidée : taille des passages envoyés au modèle et nombre maximal de passages par document.
EXTRACTION_CHUNK_SIZE=2500
EXTRACTION_MAX_CHUNKS=40
# Détection des variantes graphiques (similarité minimale entre formes normalisées).
VARIANT_SIMILARITY=0.9

